<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proiect_Nonu_Stefania_Popa_Raul_.NETMAUI.MainPage"
             Title="Rent A Car - Lista Masini">

    <Grid RowDefinitions="*, Auto" 
          Padding="10" 
          RowSpacing="10">

        <CollectionView x:Name="listView"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="10" BorderColor="Gray" CornerRadius="5">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Marca}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                <Label Text="{Binding Model}" FontSize="14" />
                                <Label Text="{Binding PretPeZi, StringFormat='Pret: {0} RON / zi'}" TextColor="Green"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                    Text="Vezi Inchirieri"
                    FontSize="12"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    Clicked="OnVeziInchirieriClicked" 
                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                Text="+ Adauga Masina"
                Clicked="OnAddClicked"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                HeightRequest="50" />
    </Grid>

</ContentPage>